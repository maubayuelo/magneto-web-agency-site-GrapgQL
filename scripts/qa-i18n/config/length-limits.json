{
  "version": 1,
  "status": "set",
  "statusNote": "Set in the design round (docs/specs/design-round.md rev 4.1, B8), from B1-A (CTA text width 285 px at 375) and B5-c (the home hero grows with its title).",
  "set": { "by": "Mauricio", "on": "2026-11-11" },
  "ratioWarnAbove": 1.35,
  "types": {
    "cta-label": {
      "maxChars": 38,
      "select": {
        "content-json": ["*.ctaText", "*.ctaTextHero", "*.prefooterCtaText", "*.secondaryCtaText", "*.linkText", "*.aboutCtaText"],
        "dictionary": ["common.bookStrategyCall"]
      }
    },
    "hero-title": { "maxChars": 100, "select": { "content-json": ["heroContent.heroTitle"] } },
    "button": {
      "maxChars": 26,
      "select": {
        "dictionary": [
          "header.scheduleCall", "common.goHome", "common.close", "contactForm.submit", "bookingModal.continue",
          "emailModal.download", "emailModal.continueDownload", "emailModal.submitting", "cmsFallback.requestQuote"
        ]
      }
    }
  }
}
